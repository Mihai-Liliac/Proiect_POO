<Window x:Class="HotelUI.DateSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Dates" Height="300" Width="400" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen">
    <Border Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1">
        <StackPanel Margin="20">
            <TextBlock Text="Select Booking Period" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Check-in Date:"/>
            <DatePicker x:Name="PickStart" Margin="0,5,0,15"/>
            <TextBlock Text="Check-out Date:"/>
            <DatePicker x:Name="PickEnd" Margin="0,5,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Cancel" Click="Cancel_Click" Width="100" Height="35" Margin="0,0,10,0"/>
                <Button Content="Confirm" Click="Confirm_Click" Width="100" Height="35" Background="#10B981" Foreground="White"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>